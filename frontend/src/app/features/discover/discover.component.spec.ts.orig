import { ComponentFixture, TestBed } from '@angular/core/testing';
import { ChangeDetectorRef, NO_ERRORS_SCHEMA } from '@angular/core';
import { DragDropModule } from '@angular/cdk/drag-drop';
import { of, Subject } from 'rxjs';
import { DiscoverComponent } from './discover.component';
import { StateManagementService } from '../../core/services/state-management.service';
import { RouteStateService } from '../../core/services/route-state.service';
import { UrlParamService } from '../../core/services/url-param.service';
import { SearchFilters } from '../../models/search-filters.model';

describe('DiscoverComponent', () => {
  let component: DiscoverComponent;
  let fixture: ComponentFixture<DiscoverComponent>;
  let mockStateService: jasmine.SpyObj<StateManagementService>;
  let mockRouteState: jasmine.SpyObj<RouteStateService>;
  let mockUrlParamService: jasmine.SpyObj<UrlParamService>;
  let filtersSubject: Subject<SearchFilters>;
  let stateSubject: Subject<any>;

  beforeEach(async () => {
    // Create observables for state management
    filtersSubject = new Subject<SearchFilters>();
    stateSubject = new Subject<any>();

    // Create mock services
    mockStateService = jasmine.createSpyObj('StateManagementService', [
      'updateFilters',
      'resetFilters',
      'clearAllFilters',
      'getCurrentState',
    ]);
    mockStateService.filters$ = filtersSubject.asObservable();
    mockStateService.state$ = stateSubject.asObservable();
    mockStateService.getCurrentState = jasmine
      .createSpy('getCurrentState')
      .and.returnValue({
        filters: {},
        results: [],
        loading: false,
        error: null,
        totalResults: 0,
      });

    mockRouteState = jasmine.createSpyObj('RouteStateService', [
      'getCurrentParams',
      'setParams',
      'removeParam',
    ]);

    mockUrlParamService = jasmine.createSpyObj('UrlParamService', [
      'setHighlightParam',
      'setHighlightRange',
    ]);

    await TestBed.configureTestingModule({
      declarations: [DiscoverComponent],
      imports: [DragDropModule],
      providers: [
        { provide: StateManagementService, useValue: mockStateService },
        { provide: RouteStateService, useValue: mockRouteState },
        { provide: UrlParamService, useValue: mockUrlParamService },
      ],
      schemas: [NO_ERRORS_SCHEMA], // Allow custom elements
    }).compileComponents();

    fixture = TestBed.createComponent(DiscoverComponent);
    component = fixture.componentInstance;

    // Mock localStorage
    let localStore: { [key: string]: string } = {};
    spyOn(localStorage, 'getItem').and.callFake((key: string) => {
      return localStore[key] || null;
    });
    spyOn(localStorage, 'setItem').and.callFake(
      (key: string, value: string) => {
        localStore[key] = value;
      }
    );
    spyOn(localStorage, 'clear').and.callFake(() => {
      localStore = {};
    });

    fixture.detectChanges();
  });

  describe('Component Initialization', () => {
    it('should create', () => {
      expect(component).toBeTruthy();
    });

    it('should initialize with default panel configuration', () => {
      expect(component.panels).toBeDefined();
      expect(component.panels.length).toBeGreaterThan(0);
      expect(component.panels[0].id).toBe('query-control');
    });

    it('should initialize with empty selection count', () => {
      expect(component.selectionCount).toBe(0);
      expect(component.hasActiveFilters).toBe(false);
    });

    it('should subscribe to state filters on init', () => {
      const filters: SearchFilters = {
        modelCombos: [{ manufacturer: 'Ford', model: 'F-150' }],
      };

      filtersSubject.next(filters);

      expect(component.currentFilters).toEqual(filters);
      expect(component.selectionCount).toBe(1);
      expect(component.hasActiveFilters).toBe(true);
    });
  });

  describe('Filter Updates', () => {
    it('should update selection count when filters change', () => {
      const filters: SearchFilters = {
        modelCombos: [
          { manufacturer: 'Ford', model: 'F-150' },
          { manufacturer: 'Chevrolet', model: 'Corvette' },
        ],
      };

      filtersSubject.next(filters);

      expect(component.selectionCount).toBe(2);
      expect(component.hasActiveFilters).toBe(true);
    });

    it('should handle empty model combos', () => {
      const filters: SearchFilters = {
        modelCombos: [],
      };

      filtersSubject.next(filters);

      expect(component.selectionCount).toBe(0);
      expect(component.hasActiveFilters).toBe(false);
    });

    it('should handle filters without model combos', () => {
      const filters: SearchFilters = {
        yearMin: 1960,
        yearMax: 1980,
      };

      filtersSubject.next(filters);

      expect(component.selectionCount).toBe(0);
      expect(component.hasActiveFilters).toBe(false);
    });
  });

  describe('Filter Operations', () => {
    it('should handle filter add with multiselect type', () => {
      const filter = {
        type: 'multiselect' as const,
        field: 'bodyClass',
        values: ['Sedan', 'SUV'],
      };

      component.onFilterAdd(filter);

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        bodyClass: 'Sedan,SUV',
      });
    });

    it('should handle filter add with range type for year', () => {
      const filter = {
        type: 'range' as const,
        field: 'year',
        rangeMin: 1960,
        rangeMax: 1980,
      };

      component.onFilterAdd(filter);

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        yearMin: 1960,
        yearMax: 1980,
      });
    });

    it('should handle filter add with single value', () => {
      const filter = {
        type: 'select' as const,
        field: 'dataSource',
        value: 'NHTSA',
      };

      component.onFilterAdd(filter);

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        dataSource: 'NHTSA',
      });
    });

    it('should handle filter remove', () => {
      const event = {
        field: 'bodyClass',
        updates: { bodyClass: undefined },
      };

      component.onFilterRemove(event);

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        bodyClass: undefined,
      });
    });

    it('should handle highlight remove', () => {
      component.onHighlightRemove('h_manufacturer');

      expect(mockRouteState.removeParam).toHaveBeenCalledWith('h_manufacturer');
    });

    it('should handle clear all highlights', () => {
      mockRouteState.getCurrentParams.and.returnValue({
        models: 'Ford:F-150',
        h_manufacturer: 'Ford',
        h_yearMin: '1960',
        h_yearMax: '1980',
      });

      component.onClearHighlights();

      expect(mockRouteState.setParams).toHaveBeenCalledWith({
        models: 'Ford:F-150',
      });
    });

    it('should handle clear all filters', () => {
      component.onClearAll();

      expect(mockStateService.clearAllFilters).toHaveBeenCalled();
    });
  });

  describe('Panel Order Management', () => {
    it('should load panel order from localStorage', () => {
      const savedPanels = [
        { id: 'vehicle-results', title: 'Vehicle Results', collapsed: true },
        { id: 'query-control', title: 'Query Control', collapsed: false },
      ];
      (localStorage.getItem as jasmine.Spy).and.returnValue(
        JSON.stringify(savedPanels)
      );

      component['loadPanelOrder']();

      expect(component.panels[0].id).toBe('vehicle-results');
      expect(component.panels[0].collapsed).toBe(true);
    });

    it('should handle localStorage parse errors gracefully', () => {
      (localStorage.getItem as jasmine.Spy).and.returnValue('invalid json');
      spyOn(console, 'error');

      component['loadPanelOrder']();

      expect(console.error).toHaveBeenCalled();
    });

    it('should save panel order to localStorage', () => {
      component['savePanelOrder']();

      expect(localStorage.setItem).toHaveBeenCalledWith(
        'discover-panel-order',
        jasmine.any(String)
      );
    });

    it('should handle localStorage save errors gracefully', () => {
      (localStorage.setItem as jasmine.Spy).and.throwError('Storage full');
      spyOn(console, 'error');

      component['savePanelOrder']();

      expect(console.error).toHaveBeenCalled();
    });

    it('should save panel order when collapsed state changes', () => {
      component.onPanelCollapsedChange();

      expect(localStorage.setItem).toHaveBeenCalled();
    });

    it('should reset panel order to default', () => {
      component.resetPanelOrder();

      expect(component.panels[0].id).toBe('query-control');
      expect(localStorage.setItem).toHaveBeenCalled();
    });
  });

  describe('Panel Drag and Drop', () => {
    it('should reorder panels on drop', () => {
      const initialOrder = component.panels.map((p) => p.id);
      const event = {
        previousIndex: 0,
        currentIndex: 2,
      } as any;

      component.onPanelDrop(event);

      const newOrder = component.panels.map((p) => p.id);
      expect(newOrder).not.toEqual(initialOrder);
      expect(localStorage.setItem).toHaveBeenCalled();
    });

    it('should not save if panel position unchanged', () => {
      const event = {
        previousIndex: 1,
        currentIndex: 1,
      } as any;

      (localStorage.setItem as jasmine.Spy).calls.reset();
      component.onPanelDrop(event);

      expect(localStorage.setItem).not.toHaveBeenCalled();
    });
  });

  describe('Pop-out Window Management', () => {
    it('should identify popped out panels correctly', () => {
      component['poppedOutPanels'].add('vehicle-results');

      expect(component.isPanelPoppedOut('vehicle-results')).toBe(true);
      expect(component.isPanelPoppedOut('query-control')).toBe(false);
    });

    it('should handle pop-out window creation errors', () => {
      spyOn(window, 'open').and.returnValue(null);
      spyOn(console, 'error');

      component.popOutPanel('vehicle-results');

      expect(console.error).toHaveBeenCalled();
      expect(component.isPanelPoppedOut('vehicle-results')).toBe(false);
    });

    it('should mark panel as popped out when window opens', () => {
      const mockWindow = jasmine.createSpyObj('Window', ['close']);
      mockWindow.closed = false;
      spyOn(window, 'open').and.returnValue(mockWindow);

      component.popOutPanel('vehicle-results');

      expect(component.isPanelPoppedOut('vehicle-results')).toBe(true);
    });

    it('should handle unknown panel ID', () => {
      spyOn(console, 'error');

      component.popOutPanel('invalid-panel');

      expect(console.error).toHaveBeenCalledWith(
        'Unknown panel ID:',
        'invalid-panel'
      );
    });
  });

  describe('State Broadcasting to Pop-outs', () => {
    it('should broadcast state updates to all popout windows', () => {
      // Set up a mock popout window with BroadcastChannel
      const mockChannel = jasmine.createSpyObj('BroadcastChannel', [
        'postMessage',
        'close',
      ]);
      const mockWindow = { closed: false } as any;

      component['popoutWindows'].set('vehicle-results', {
        window: mockWindow,
        channel: mockChannel,
        checkInterval: null as any,
      });

      const state = {
        filters: { modelCombos: [{ manufacturer: 'Ford', model: 'F-150' }] },
        results: [],
        loading: false,
        error: null,
        totalResults: 0,
      };

      stateSubject.next(state);

      expect(mockChannel.postMessage).toHaveBeenCalledWith({
        type: 'STATE_UPDATE',
        state,
      });
    });

    it('should not broadcast to closed popout windows', () => {
      const mockChannel = jasmine.createSpyObj('BroadcastChannel', [
        'postMessage',
      ]);
      const mockWindow = { closed: true } as any;

      component['popoutWindows'].set('vehicle-results', {
        window: mockWindow,
        channel: mockChannel,
        checkInterval: null as any,
      });

      const state = { filters: {}, results: [], loading: false };
      stateSubject.next(state);

      expect(mockChannel.postMessage).not.toHaveBeenCalled();
    });
  });

  describe('Pop-out Message Handling', () => {
    beforeEach(() => {
      const mockChannel = jasmine.createSpyObj('BroadcastChannel', [
        'postMessage',
        'close',
      ]);
      component['popoutWindows'].set('vehicle-results', {
        window: {} as any,
        channel: mockChannel,
        checkInterval: null as any,
      });
    });

    it('should handle PANEL_READY message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: { data: { type: 'PANEL_READY' } } as any,
      });

      expect(mockStateService.getCurrentState).toHaveBeenCalled();
    });

    it('should handle PICKER_SELECTION_CHANGE with model combos', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'PICKER_SELECTION_CHANGE',
            payload: {
              urlParam: 'modelCombos',
              urlValue: 'Ford:F-150,Chevrolet:Corvette',
            },
          },
        } as any,
      });

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        modelCombos: [
          { manufacturer: 'Ford', model: 'F-150' },
          { manufacturer: 'Chevrolet', model: 'Corvette' },
        ],
      });
    });

    it('should handle PICKER_SELECTION_CHANGE with invalid model combo format', () => {
      spyOn(console, 'warn');
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'PICKER_SELECTION_CHANGE',
            payload: {
              urlParam: 'modelCombos',
              urlValue: 'Invalid:Format:Extra',
            },
          },
        } as any,
      });

      expect(console.warn).toHaveBeenCalled();
    });

    it('should handle legacy SELECTION_CHANGE message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'SELECTION_CHANGE',
            data: [{ manufacturer: 'Ford', model: 'F-150' }],
          },
        } as any,
      });

      expect(mockStateService.updateFilters).toHaveBeenCalledWith({
        modelCombos: [{ manufacturer: 'Ford', model: 'F-150' }],
      });
    });

    it('should handle PICKER_CLEAR message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'PICKER_CLEAR',
            payload: { urlParam: 'modelCombos' },
          },
        } as any,
      });

      expect(mockRouteState.removeParam).toHaveBeenCalledWith('modelCombos');
    });

    it('should handle CLEAR_ALL message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: { type: 'CLEAR_ALL' },
        } as any,
      });

      expect(mockStateService.resetFilters).toHaveBeenCalled();
    });

    it('should handle FILTER_ADD message', () => {
      const filter = {
        type: 'select' as const,
        field: 'bodyClass',
        value: 'Sedan',
      };

      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'FILTER_ADD',
            payload: filter,
          },
        } as any,
      });

      expect(mockStateService.updateFilters).toHaveBeenCalled();
    });

    it('should handle FILTER_REMOVE message', () => {
      const event = {
        field: 'bodyClass',
        updates: { bodyClass: undefined },
      };

      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'FILTER_REMOVE',
            payload: event,
          },
        } as any,
      });

      expect(mockStateService.updateFilters).toHaveBeenCalled();
    });

    it('should handle HIGHLIGHT_MANUFACTURER message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'HIGHLIGHT_MANUFACTURER',
            payload: 'Ford',
          },
        } as any,
      });

      expect(mockUrlParamService.setHighlightParam).toHaveBeenCalledWith(
        'manufacturer',
        'Ford'
      );
    });

    it('should handle HIGHLIGHT_YEAR_RANGE message', () => {
      component['popoutMessages$'].next({
        panelId: 'vehicle-results',
        event: {
          data: {
            type: 'HIGHLIGHT_YEAR_RANGE',
            payload: { yearMin: 1960, yearMax: 1980 },
          },
        } as any,
      });

      expect(mockUrlParamService.setHighlightRange).toHaveBeenCalledWith({
        yearMin: 1960,
        yearMax: 1980,
      });
    });
  });

  describe('Component Cleanup', () => {
    it('should clean up on destroy', () => {
      const mockChannel = jasmine.createSpyObj('BroadcastChannel', ['close']);
      const mockWindow = jasmine.createSpyObj('Window', ['close']);
      mockWindow.closed = false;
      const mockInterval = 123;

      component['popoutWindows'].set('vehicle-results', {
        window: mockWindow,
        channel: mockChannel,
        checkInterval: mockInterval,
      });

      spyOn(window, 'clearInterval');

      component.ngOnDestroy();

      expect(mockChannel.close).toHaveBeenCalled();
      expect(mockWindow.close).toHaveBeenCalled();
      expect(window.clearInterval).toHaveBeenCalledWith(mockInterval);
    });

    it('should not attempt to close already-closed windows', () => {
      const mockChannel = jasmine.createSpyObj('BroadcastChannel', ['close']);
      const mockWindow = jasmine.createSpyObj('Window', ['close']);
      mockWindow.closed = true;

      component['popoutWindows'].set('vehicle-results', {
        window: mockWindow,
        channel: mockChannel,
        checkInterval: null as any,
      });

      component.ngOnDestroy();

      expect(mockWindow.close).not.toHaveBeenCalled();
      expect(mockChannel.close).toHaveBeenCalled();
    });
  });
});
